<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spiderx_description</name>
  <version>0.0.1</version>
  <description>SpiderX quadruped robot description: URDF/xacro, meshes, Gazebo Fortress world and launch, legacy Gazebo Classic config</description>
  <maintainer email="jagadeswar@gmail.com">Jagadeswar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclpy</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <!-- Legacy Gazebo Classic path (urdf/spiderx.gazebo, urdf/spiderx.trans). -->
  <depend>gazebo_ros2_control</depend>

  <!-- Gazebo Fortress path (launch/fortress.launch.py). -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <!-- M1: urdf/spiderx_fortress_control.xacro (enable_control:=true) -->
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
