<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spiderx_firmware</name>
  <version>0.1.0</version>
  <description>SpiderX real-hardware layer: RPLidar A1 launch and interface templates for actuators and IMU. Contains no microcontroller firmware yet.</description>
  <maintainer email="jagadeswar@gmail.com">Jagadeswar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
