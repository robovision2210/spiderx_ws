#!/usr/bin/env python3
"""Check the spiderx_controller configs against the SpiderX URDF. Exit code 0 = pass."""
import argparse
import sys

from spiderx_controller.config_check import check, load_configs, load_urdf


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--urdf', help='URDF file (default: expand the installed SpiderX xacro)')
    parser.add_argument('--config-dir', help='config directory (default: installed share)')
    args = parser.parse_args()
    errors, info = check(load_urdf(args.urdf), *load_configs(args.config_dir))
    for line in info:
        print(f'[OK]   {line}')
    for line in errors:
        print(f'[FAIL] {line}')
    print('Controller configuration: ' + ('FAILED' if errors else 'valid'))
    return 1 if errors else 0


if __name__ == '__main__':
    sys.exit(main())
