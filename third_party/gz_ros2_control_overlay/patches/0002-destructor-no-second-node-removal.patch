+
+// SpiderX overlay patch for gz_ros2_control 0.7.15; not part of upstream. Offline: no Gazebo.
+// Replays the shutdown of a Gazebo run in its own context: the plugin's executor spins the
+// controller-manager node in a thread (as Configure() does); on shutdown the controller manager's
+// pre-shutdown callback removes its own node and cancels the executor (as controller_manager
+// 2.51.0 does); then the plugin tears down with stop_executor_thread(), as its destructor now does.
+
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+#include <rclcpp/rclcpp.hpp>
+
+#include "gz_ros2_control/gz_ros2_control_plugin.hpp"
+#include "shutdown_teardown.hpp"
+
+namespace
+{
+
+struct Rig
+{
+  rclcpp::Context::SharedPtr context = std::make_shared<rclcpp::Context>();
+  std::shared_ptr<rclcpp::executors::MultiThreadedExecutor> executor;
+  rclcpp::Node::SharedPtr node;
+  std::thread spin_thread;
+  rclcpp::PreShutdownCallbackHandle pre_shutdown;
+
+  explicit Rig(bool start_thread = true, bool controller_manager_self_removal = true)
+  {
+    context->init(0, nullptr);
+    rclcpp::ExecutorOptions options;
+    options.context = context;
+    executor = std::make_shared<rclcpp::executors::MultiThreadedExecutor>(options, 2);
+    node = std::make_shared<rclcpp::Node>(
+      "controller_manager", rclcpp::NodeOptions().context(context));
+    executor->add_node(node);
+    if (start_thread) {
+      auto ex = executor;
+      spin_thread = std::thread([ex]() {ex->spin();});
+      // spin() sets the executor's spinning flag itself: a cancel() before that is lost (an
+      // rclcpp race, not part of the teardown under test), so wait until it is spinning.
+      for (int i = 0; i < 5000 && !executor->is_spinning(); ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      }
+    }
+    if (controller_manager_self_removal) {
+      // controller_manager 2.51.0 (controller_manager.cpp, pre-shutdown callback)
+      auto ex = executor;
+      auto base = node->get_node_base_interface();
+      pre_shutdown = context->add_pre_shutdown_callback(
+        [ex, base]() {
+          if (base->get_associated_with_executor_atomic().load()) {
+            ex->remove_node(base);
+          }
+          ex->cancel();
+        });
+    }
+  }
+
+  ~Rig()
+  {
+    if (spin_thread.joinable()) {
+      executor->cancel();
+      spin_thread.join();
+    }
+    if (context->is_valid()) {
+      context->shutdown("test end");
+    }
+  }
+};
+
+}  // namespace
+
+// The plugin destroyed before Configure(): no executor, no spin thread, no controller manager.
+TEST(ShutdownTeardown, PluginDestroyedBeforeConfigure)
+{
+  auto plugin = std::make_unique<gz_ros2_control::GazeboSimROS2ControlPlugin>();
+  EXPECT_NO_THROW(plugin.reset());
+}
+
+// The 0.7.15 defect: after the controller manager removed its own node, a second removal throws.
+TEST(ShutdownTeardown, SecondRemovalThrowsAfterSelfRemoval)
+{
+  Rig rig;
+  rig.context->shutdown("SIGINT");
+  EXPECT_FALSE(rig.node->get_node_base_interface()->get_associated_with_executor_atomic().load());
+  try {
+    rig.executor->remove_node(rig.node);
+    FAIL() << "expected std::runtime_error";
+  } catch (const std::runtime_error & e) {
+    EXPECT_EQ(std::string(e.what()), "Node needs to be associated with an executor.");
+  }
+}
+
+// The backported teardown after the full shutdown sequence: no exception, thread joined.
+TEST(ShutdownTeardown, StopsAfterControllerManagerSelfRemoval)
+{
+  Rig rig;
+  rig.context->shutdown("SIGINT");
+  std::shared_ptr<rclcpp::Executor> executor = rig.executor;
+  EXPECT_NO_THROW(gz_ros2_control::stop_executor_thread(executor, rig.spin_thread));
+  EXPECT_FALSE(rig.spin_thread.joinable());
+}
+
+// Teardown while the context is still running (no pre-shutdown callback has run yet).
+TEST(ShutdownTeardown, StopsWhileSpinning)
+{
+  Rig rig(true, false);
+  ASSERT_TRUE(rig.executor->is_spinning());
+  std::shared_ptr<rclcpp::Executor> executor = rig.executor;
+  EXPECT_NO_THROW(gz_ros2_control::stop_executor_thread(executor, rig.spin_thread));
+  EXPECT_FALSE(rig.spin_thread.joinable());
+}
+
+// Configure() returned after creating the executor but before starting the spin thread.
+TEST(ShutdownTeardown, ExecutorWithoutSpinThread)
+{
+  Rig rig(false, false);
+  std::shared_ptr<rclcpp::Executor> executor = rig.executor;
+  EXPECT_FALSE(rig.spin_thread.joinable());
+  EXPECT_NO_THROW(gz_ros2_control::stop_executor_thread(executor, rig.spin_thread));
+}
+
+// No executor at all: nothing is dereferenced or joined.
+TEST(ShutdownTeardown, NoExecutor)
+{
+  std::shared_ptr<rclcpp::Executor> executor;
+  std::thread never_started;
+  EXPECT_NO_THROW(gz_ros2_control::stop_executor_thread(executor, never_started));
+}
+
+// A second teardown does not join twice.
+TEST(ShutdownTeardown, Idempotent)
+{
+  Rig rig;
+  rig.context->shutdown("SIGINT");
+  std::shared_ptr<rclcpp::Executor> executor = rig.executor;
+  gz_ros2_control::stop_executor_thread(executor, rig.spin_thread);
+  EXPECT_NO_THROW(gz_ros2_control::stop_executor_thread(executor, rig.spin_thread));
+}
