+// SpiderX overlay patch for gz_ros2_control 0.7.15; a backport of upstream humble commit
+// 366137556d1fe3adf327a99b17261dcde549e655 ("Don't remove the node at destruction (#683) (#686)",
+// released in 0.7.17), with guards for a partial Configure().
+
+#ifndef SHUTDOWN_TEARDOWN_HPP_
+#define SHUTDOWN_TEARDOWN_HPP_
+
+#include <memory>
+#include <thread>
+
+#include <rclcpp/executor.hpp>
+
+namespace gz_ros2_control
+{
+
+/// Stop the plugin's executor thread at destruction.
+/// The controller manager is not removed from the executor here: its own pre-shutdown callback
+/// (controller_manager 2.51.0) already removes it, and rclcpp's Executor::remove_node throws for
+/// a node that is no longer associated with an executor (the 0.7.15 abort at shutdown).
+/// Unlike upstream 0.7.17, a missing executor (Configure() returned before creating it) and a
+/// spin thread that never started are skipped rather than dereferenced or joined.
+inline void stop_executor_thread(
+  const std::shared_ptr<rclcpp::Executor> & executor, std::thread & spin_thread)
+{
+  if (executor) {
+    executor->cancel();
+  }
+  if (spin_thread.joinable()) {
+    spin_thread.join();
+  }
+}
+
+}  // namespace gz_ros2_control
+
+#endif  // SHUTDOWN_TEARDOWN_HPP_
