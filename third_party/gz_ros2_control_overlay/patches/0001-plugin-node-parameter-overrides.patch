+// SpiderX overlay patch for gz_ros2_control 0.7.15; not part of upstream. Offline: no Gazebo and
+// no executor. Each test replays the order of GazeboSimROS2ControlPlugin::Configure() in its own
+// context: init without arguments, create the plugin node with plugin_node_options() (as
+// Configure() now does), then install the files, remapping rules and robot_description as the
+// context's global arguments, then declare the gain with declare_position_proportional_gain()
+// (as GazeboSimSystem::initSim() now does).
+
+#include <gtest/gtest.h>
+#include <unistd.h>
+
+#include <cmath>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "rcl/arguments.h"
+#include "rclcpp/rclcpp.hpp"
+
+#include "parameter_loading.hpp"
+
+namespace
+{
+namespace fs = std::filesystem;
+using gz_ros2_control::declare_position_proportional_gain;
+using gz_ros2_control::plugin_node_options;
+
+const char kGain[] = "position_proportional_gain";
+
+const char kControllers[] =
+  "controller_manager:\n"
+  "  ros__parameters:\n"
+  "    update_rate: 100\n"
+  "leg_trajectory_controller:\n"
+  "  ros__parameters:\n"
+  "    joints: [lf_hip, rr_foot_joint]\n";
+
+const char kPlant[] =
+  "gz_ros2_control:\n"
+  "  ros__parameters:\n"
+  "    position_proportional_gain: 1.0\n";
+
+class ParameterLoading : public ::testing::Test
+{
+protected:
+  void SetUp() override
+  {
+    context_ = std::make_shared<rclcpp::Context>();
+    context_->init(0, nullptr);
+    static int counter = 0;
+    dir_ = fs::temp_directory_path() /
+      ("gz_parameter_loading_" + std::to_string(::getpid()) + "_" + std::to_string(counter++));
+    fs::create_directories(dir_);
+  }
+
+  void TearDown() override
+  {
+    context_->shutdown("test finished");
+    fs::remove_all(dir_);
+  }
+
+  std::string file(const std::string & name, const std::string & text)
+  {
+    const fs::path path = dir_ / name;
+    std::ofstream(path) << text;
+    return path.string();
+  }
+
+  // The plugin node as Configure() creates it.
+  rclcpp::Node::SharedPtr plugin_node(
+    const std::vector<std::string> & files, const std::string & ns = "/")
+  {
+    auto options = plugin_node_options(files);
+    options.context(context_);
+    return std::make_shared<rclcpp::Node>("gz_ros2_control", ns, options);
+  }
+
+  rclcpp::Node::SharedPtr node(const std::string & name, const std::string & ns = "/")
+  {
+    return std::make_shared<rclcpp::Node>(name, ns, rclcpp::NodeOptions().context(context_));
+  }
+
+  // What Configure() does after creating its node: --ros-args, one --params-file per file,
+  // then --ros-args -r <rule> per remapping, then -p robot_description:=<urdf>.
+  void install_global_arguments(
+    const std::vector<std::string> & files, const std::vector<std::string> & remappings)
+  {
+    std::vector<std::string> arguments = {"--ros-args"};
+    for (const auto & f : files) {
+      arguments.push_back(RCL_PARAM_FILE_FLAG);
+      arguments.push_back(f);
+    }
+    if (!remappings.empty()) {
+      arguments.push_back(RCL_ROS_ARGS_FLAG);
+      for (const auto & r : remappings) {
+        arguments.push_back(RCL_REMAP_FLAG);
+        arguments.push_back(r);
+      }
+    }
+    arguments.push_back(RCL_PARAM_FLAG);
+    arguments.push_back("robot_description:=<robot name=\"r\"/>");
+    std::vector<const char *> argv;
+    for (const auto & a : arguments) {
+      argv.push_back(a.c_str());
+    }
+    rcl_arguments_t rcl_args = rcl_get_zero_initialized_arguments();
+    ASSERT_EQ(
+      RCL_RET_OK,
+      rcl_parse_arguments(
+        static_cast<int>(argv.size()), argv.data(), rcl_get_default_allocator(), &rcl_args));
+    context_->get_rcl_context()->global_arguments = rcl_args;
+  }
+
+  static double declared(const rclcpp::Node::SharedPtr & n, bool expect_ok = true)
+  {
+    double gain = std::numeric_limits<double>::quiet_NaN();
+    std::string error;
+    EXPECT_EQ(expect_ok, declare_position_proportional_gain(*n, gain, error)) << error;
+    EXPECT_EQ(expect_ok, error.empty()) << error;
+    return gain;
+  }
+
+  std::shared_ptr<rclcpp::Context> context_;
+  fs::path dir_;
+};
+
+// The defect this patch removes: with stock 0.7.15 the node is created with no arguments and
+// the files arrive only as global arguments installed afterwards.
+TEST_F(ParameterLoading, StockOrderNeverDeliveredTheFileToThePluginNode)
+{
+  const auto plant = file("plant.yaml", kPlant);
+  auto stock = std::make_shared<rclcpp::Node>(
+    "gz_ros2_control", "/", rclcpp::NodeOptions().context(context_));
+  install_global_arguments({plant}, {});
+  EXPECT_DOUBLE_EQ(0.1, declared(stock));
+}
+
+TEST_F(ParameterLoading, UnspecifiedGainKeepsTheUpstreamDefault)
+{
+  const auto controllers = file("controllers.yaml", kControllers);
+  auto plugin = plugin_node({controllers});
+  install_global_arguments({controllers}, {});
+  EXPECT_EQ(0.1, declared(plugin));
+}
+
+TEST_F(ParameterLoading, ConfiguredGainReachesThePluginNode)
+{
+  const auto controllers = file("controllers.yaml", kControllers);
+  const auto plant = file("plant.yaml", kPlant);
+  auto plugin = plugin_node({controllers, plant});
+  install_global_arguments({controllers, plant}, {});
+  EXPECT_EQ(1.0, declared(plugin));
+}
+
+TEST_F(ParameterLoading, NamespacedPluginNodeIsAddressedByItsFullName)
+{
+  const auto full = file(
+    "full.yaml", "/r1/gz_ros2_control:\n  ros__parameters:\n    position_proportional_gain: 1.0\n");
+  const auto wildcard = file(
+    "wild.yaml", "/**/gz_ros2_control:\n  ros__parameters:\n    position_proportional_gain: 0.7\n");
+  const auto root = file("root.yaml", kPlant);
+  EXPECT_EQ(1.0, declared(plugin_node({full}, "/r1")));
+  EXPECT_EQ(0.7, declared(plugin_node({wildcard}, "/r2")));
+  EXPECT_EQ(0.1, declared(plugin_node({root}, "/r3")));   // /gz_ros2_control is another node
+}
+
+TEST_F(ParameterLoading, LaterFilesTakePrecedenceAsForTheControllerManager)
+{
+  const auto a = file(
+    "a.yaml", "/**/gz_ros2_control:\n  ros__parameters:\n    position_proportional_gain: 0.5\n");
+  const auto b = file(
+    "b.yaml", "/**/gz_ros2_control:\n  ros__parameters:\n    position_proportional_gain: 1.0\n");
+  EXPECT_EQ(1.0, declared(plugin_node({a, b}, "/ab")));
+  EXPECT_EQ(0.5, declared(plugin_node({b, a}, "/ba")));
+}
+
+TEST_F(ParameterLoading, ControllerManagerControllersAndRemappingsAreUnchanged)
+{
+  const auto controllers = file("controllers.yaml", kControllers);
+  const auto plant = file("plant.yaml", kPlant);
+  auto plugin = plugin_node({controllers, plant});
+  // Created as stock 0.7.15 creates the node.
+  auto stock = std::make_shared<rclcpp::Node>(
+    "gz_ros2_control", "/stock", rclcpp::NodeOptions().context(context_));
+  install_global_arguments({controllers, plant}, {"/old_topic:=/new_topic"});
+  auto cm = node("controller_manager");
+  auto controller = node("leg_trajectory_controller");
+
+  EXPECT_EQ(100, cm->declare_parameter<int64_t>("update_rate", 0));
+  EXPECT_EQ(
+    "<robot name=\"r\"/>", cm->declare_parameter<std::string>("robot_description", ""));
+  EXPECT_FALSE(cm->has_parameter(kGain));
+  EXPECT_EQ(
+    (std::vector<std::string>{"lf_hip", "rr_foot_joint"}),
+    controller->declare_parameter<std::vector<std::string>>(
+      "joints", std::vector<std::string>{}));
+  EXPECT_EQ("/new_topic", cm->get_node_topics_interface()->resolve_topic_name("/old_topic"));
+
+  // The plugin node receives only its own parameter entries. Remapping rules are resolved
+  // against the global arguments when a name is resolved, so they reach the plugin node exactly
+  // as they reach a node created the stock way: the patch does not change that.
+  const auto & overrides = plugin->get_node_parameters_interface()->get_parameter_overrides();
+  ASSERT_EQ(1u, overrides.size());
+  EXPECT_EQ(1u, overrides.count(kGain));
+  EXPECT_TRUE(stock->get_node_parameters_interface()->get_parameter_overrides().empty());
+  EXPECT_EQ(
+    stock->get_node_topics_interface()->resolve_topic_name("/old_topic"),
+    plugin->get_node_topics_interface()->resolve_topic_name("/old_topic"));
+  EXPECT_EQ(1.0, declared(plugin));
+}
+
+TEST_F(ParameterLoading, SecondSystemOnTheSameNodeReadsTheDeclaredValue)
+{
+  auto plugin = plugin_node({file("plant.yaml", kPlant)});
+  EXPECT_EQ(1.0, declared(plugin));
+  EXPECT_EQ(1.0, declared(plugin));
+}
+
+TEST_F(ParameterLoading, NonFiniteOrNonPositiveGainIsRejectedNotReplaced)
+{
+  const double nan = std::numeric_limits<double>::quiet_NaN();
+  const double inf = std::numeric_limits<double>::infinity();
+  int i = 0;
+  for (const double value : {nan, inf, -inf, 0.0, -1.0}) {
+    auto n = std::make_shared<rclcpp::Node>(
+      "gz_ros2_control", "/v" + std::to_string(i++),
+      rclcpp::NodeOptions().context(context_).parameter_overrides({{kGain, value}}));
+    double gain = 0.25;
+    std::string error;
+    EXPECT_FALSE(declare_position_proportional_gain(*n, gain, error)) << value;
+    EXPECT_NE(std::string::npos, error.find("must be finite and greater than 0")) << error;
+    if (std::isnan(value)) {
+      EXPECT_TRUE(std::isnan(gain));
+    } else {
+      EXPECT_EQ(value, gain);
+    }
+  }
+}
+
+TEST_F(ParameterLoading, NonFiniteOrWrongTypeFromAFileIsRejected)
+{
+  // A non-finite value fails validation; a value of another type is not converted.
+  const std::vector<std::string> values = {".nan", ".inf", "-.inf", "1", "\"1.0\"", "true"};
+  for (size_t i = 0; i < values.size(); ++i) {
+    auto n = plugin_node(
+      {file(
+          "bad" + std::to_string(i) + ".yaml",
+          "/**/gz_ros2_control:\n  ros__parameters:\n    position_proportional_gain: " +
+          values[i] + "\n")},
+      "/bad" + std::to_string(i));
+    double gain = 0.25;
+    std::string error;
+    EXPECT_FALSE(declare_position_proportional_gain(*n, gain, error)) << values[i];
+    EXPECT_FALSE(error.empty()) << values[i];
+    if (i >= 3) {
+      EXPECT_NE(std::string::npos, error.find("must be a floating-point number")) << error;
+      EXPECT_EQ(0.25, gain) << values[i];
+    }
+  }
+}
+
+}  // namespace
