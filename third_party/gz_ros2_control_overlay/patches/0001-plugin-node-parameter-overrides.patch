+// SpiderX overlay patch for gz_ros2_control 0.7.15; not part of upstream.
+
+#ifndef PARAMETER_LOADING_HPP_
+#define PARAMETER_LOADING_HPP_
+
+#include <cmath>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "rcl/arguments.h"
+#include "rclcpp/rclcpp.hpp"
+
+namespace gz_ros2_control
+{
+
+/// Options for the plugin's own node ("gz_ros2_control").
+/**
+ * Configure() creates this node before it installs the <parameters> files as the context's
+ * global arguments, and a node's parameter overrides are fixed when the node is created, so
+ * the files never reached it. They are therefore also given to this node as node-local
+ * --params-file arguments: entries for its fully qualified name (or matching wildcards) now
+ * apply to it. Remapping rules are not passed, so its remapping is unchanged. The controller
+ * manager and the controllers still receive the files and the rules through the global
+ * arguments, as before.
+ */
+inline rclcpp::NodeOptions plugin_node_options(const std::vector<std::string> & parameter_files)
+{
+  std::vector<std::string> arguments = {RCL_ROS_ARGS_FLAG};
+  for (const auto & file : parameter_files) {
+    arguments.push_back(RCL_PARAM_FILE_FLAG);
+    arguments.push_back(file);
+  }
+  return rclcpp::NodeOptions().arguments(arguments);
+}
+
+/// Declare position_proportional_gain on \p node (default 0.1, as upstream) and validate it.
+/**
+ * A second system on the same node reads the value already declared, as upstream does.
+ * \return false, with a message in \p error, if the value is not a floating-point number or is
+ *   not finite and greater than zero. An invalid value is reported, never clamped or replaced.
+ */
+inline bool declare_position_proportional_gain(
+  rclcpp::Node & node, double & gain, std::string & error)
+{
+  constexpr double default_gain = 0.1;
+  const std::string name = "position_proportional_gain";
+  try {
+    try {
+      gain = node.declare_parameter<double>(name, default_gain);
+    } catch (const rclcpp::exceptions::ParameterAlreadyDeclaredException &) {
+      gain = node.get_parameter(name).get_value<double>();
+    }
+  } catch (const rclcpp::exceptions::InvalidParameterTypeException & ex) {
+    error = name + " must be a floating-point number: " + ex.what();
+    return false;
+  } catch (const rclcpp::ParameterTypeException & ex) {
+    error = name + " must be a floating-point number: " + ex.what();
+    return false;
+  }
+  if (!std::isfinite(gain) || gain <= 0.0) {
+    std::ostringstream message;
+    message << name << " must be finite and greater than 0, got " << gain;
+    error = message.str();
+    return false;
+  }
+  return true;
+}
+
+}  // namespace gz_ros2_control
+
+#endif  // PARAMETER_LOADING_HPP_
